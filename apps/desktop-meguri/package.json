{
  "name": "@meguri/desktop-meguri",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/main/index.mjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:renderer": "vite --host 127.0.0.1 --port 4174",
    "build": "vite build",
    "start": "electron src/main/index.mjs",
    "test": "pnpm run test:unit && pnpm run test:preload && pnpm run test:instance && pnpm run test:tray",
    "test:unit": "vitest run",
    "test:preload": "electron scripts/preload-smoke.mjs",
    "test:instance": "electron scripts/reminder-instance-smoke.mjs",
    "test:tray": "electron scripts/tray-smoke.mjs",
    "test:visual-skills": "electron scripts/skills-visual-smoke.mjs",
    "test:visual-presentation": "electron scripts/presentation-visual-smoke.mjs",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@meguri/client-sdk": "workspace:*",
    "@meguri/protocol": "workspace:*",
    "pinia": "^3.0.4",
    "vue": "^3.5.32"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.6",
    "electron": "^43.1.1",
    "typescript": "^5.9.3",
    "vite": "^8.0.8",
    "vitest": "^4.1.4",
    "vue-tsc": "^3.2.6"
  }
}
