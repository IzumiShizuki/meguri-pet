# Local AIRI -> Java Core -> hosted DeepSeek example.
# This file contains no secret and is not loaded automatically by Spring Boot.
# Keep the actual API key in the absolute, repository-external file below.

MEGURI_CORE_BIND_ADDRESS=127.0.0.1
SERVER_PORT=18080

MEGURI_LLM_PROVIDER=openai-compatible
MEGURI_LLM_BASE_URL=https://api.deepseek.com
MEGURI_LLM_MODEL=deepseek-v4-flash
MEGURI_LLM_API_KEY_FILE=D:/environment/secrets/meguri/deepseek-api-key.txt
MEGURI_LLM_RESPONSE_FORMAT=json_object
MEGURI_LLM_THINKING=disabled
MEGURI_LLM_MAX_TOKENS=1200
MEGURI_LLM_MAX_CONCURRENCY=4

# Multimodal attachment routing. v4-flash remains the fast outer text model;
# it is intentionally not in the primary capability list, so images/PDFs use
# dsv4p. Omit the fallback key/base URL to reuse the outer provider settings.
MEGURI_LLM_MULTIMODAL_PRIMARY_MODELS=deepseek-v4-pro,dsv4pro,dsv4p
MEGURI_LLM_MULTIMODAL_FALLBACK_MODEL=dsv4p
# MEGURI_LLM_MULTIMODAL_FALLBACK_BASE_URL=https://api.deepseek.com
# MEGURI_LLM_MULTIMODAL_FALLBACK_API_KEY_FILE=D:/environment/secrets/meguri/deepseek-multimodal-api-key.txt
MEGURI_LLM_MULTIMODAL_FALLBACK_THINKING=disabled
MEGURI_MULTIMODAL_MAX_ATTACHMENT_BYTES=5242880
MEGURI_MULTIMODAL_MAX_TOTAL_BYTES=10485760

# The Planner is only used for eligible Agent-mode turns. It reuses the outer
# secret file unless this optional, separate file is configured.
MEGURI_AGENT_PLANNER_MODEL=deepseek-v4-flash
# MEGURI_AGENT_PLANNER_API_KEY_FILE=D:/environment/secrets/meguri/deepseek-planner-api-key.txt
MEGURI_AGENT_PLANNER_THINKING=disabled
MEGURI_AGENT_PLANNER_MAX_TOKENS=128
MEGURI_AGENT_PLANNER_PROVIDER_TIMEOUT_MS=4000

# Deliberately absent: MEGURI_LLM_API_KEY.
# AIRI must point only to http://127.0.0.1:18080 and must never receive this key.
