# Local AIRI -> Java Core -> hosted DeepSeek example.
# This file contains no secret and is not loaded automatically by Spring Boot.
# Keep the actual API key in the absolute, repository-external file below.

MEGURI_CORE_BIND_ADDRESS=127.0.0.1
SERVER_PORT=18080

MEGURI_LLM_PROVIDER=openai-compatible
MEGURI_LLM_BASE_URL=https://api.deepseek.com
MEGURI_LLM_MODEL=deepseek-v4-flash
MEGURI_LLM_API_KEY_FILE=D:/environment/secrets/meguri/deepseek-api-key.txt
MEGURI_LLM_RESPONSE_FORMAT=json_object
MEGURI_LLM_THINKING=disabled
MEGURI_LLM_MAX_TOKENS=1200
MEGURI_LLM_MAX_CONCURRENCY=4

# Deliberately absent: MEGURI_LLM_API_KEY.
# AIRI must point only to http://127.0.0.1:18080 and must never receive this key.
